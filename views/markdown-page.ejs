<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Nine Lives Vintage — <%= pageTitle %></title>

    <link
        rel="stylesheet"
        href="/css/shop.css"
    >
</head>

<body>

<div class="page-container">

    <%- include("partials/navbar", {
        currentPage: currentPage || "",
        cartCount: typeof cartCount !== "undefined" ? cartCount : 0
    }) %>

    <main class="markdown-page-shell">
        <section class="markdown-page-hero">
            <a href="<%= backLinkHref || '/shop' %>" class="markdown-back-link">
                <span class="icon icon-arrow-right"></span>
                <span><%= backLinkLabel || 'Back to Shop' %></span>
            </a>

            <p class="markdown-eyebrow">Markdown Page</p>
            <h1><%= pageTitle %></h1>

            <% if (pageDescription) { %>
                <p class="markdown-page-description"><%= pageDescription %></p>
            <% } %>
        </section>

        <article class="markdown-content">
            <%- contentHtml %>
        </article>
    </main>

    <%- include("partials/footer") %>

</div>

</body>
</html>
