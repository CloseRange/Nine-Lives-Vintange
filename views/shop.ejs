<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Nine Lives Vintage</title>

    <link
        rel="stylesheet"
        href="/css/shop.css"
    >
</head>

<body>

<div class="page-container">

    <%- include("partials/navbar", {
        currentPage: "home",
        cartCount: typeof cartCount !== "undefined" ? cartCount : 0
    }) %>


    <!-- =========================
         HERO
    ========================== -->

    <main>
<section class="hero">

    <div class="hero-content">

        <p class="eyebrow">
            SECONDHAND STYLE, A BRIGHTER TOMORROW
        </p>

        <h1>
            Nine Lives<br>
            Vintage
        </h1>

        <p class="hero-description">
            Curated secondhand clothing for a more
            sustainable (and stylish) future.
        </p>

        <a href="/shop" class="primary-button">
            Shop All
            <span class="icon icon-arrow-right"></span>
        </a>

    </div>

    <div class="hero-art">
        <img
            src="/images/nine-lives-title.png"
            alt="Nine Lives Vintage cats"
            class="hero-title-image"
        >
    </div>

</section>

        <!-- =========================
             CATEGORY CARDS
        ========================== -->
<section class="category-grid">

    <a
        href="/shop?department=women"
        class="category-card"
        style="background-image: url('/images/categories/women.png');"
    >
        <div class="category-content">
            <h2>Women</h2>

            <p>
                Tops, bottoms,<br>
                dresses & more
            </p>

            <span class="category-arrow"><span class="icon icon-arrow-right"></span></span>
        </div>

        <div class="category-mobile">
            <span class="category-circle" style="background-image: url('/images/categories/women-small.png');"></span>
            <span class="category-label">Women</span>
        </div>
    </a>


    <a
        href="/shop?department=men"
        class="category-card"
        style="background-image: url('/images/categories/men.png');"
    >
        <div class="category-content">
            <h2>Men</h2>

            <p>
                Tees, hoodies,<br>
                flannels & more
            </p>

            <span class="category-arrow"><span class="icon icon-arrow-right"></span></span>
        </div>

        <div class="category-mobile">
            <span class="category-circle" style="background-image: url('/images/categories/men-small.png');"></span>
            <span class="category-label">Men</span>
        </div>
    </a>


    <a
        href="/shop?department=accessories"
        class="category-card"
        style="background-image: url('/images/categories/accessory.png');"
    >
        <div class="category-content">
            <h2>Accessories</h2>

            <p>
                Bags, hats,<br>
                jewelry & more
            </p>

            <span class="category-arrow"><span class="icon icon-arrow-right"></span></span>
        </div>

        <div class="category-mobile">
            <span class="category-circle" style="background-image: url('/images/categories/accessory-small.png');"></span>
            <span class="category-label">Accessories</span>
        </div>
    </a>


    <a
        href="/shop?department=new-arrivals"
        class="category-card"
        style="background-image: url('/images/categories/new-arrivals.png');"
    >
        <div class="category-content">
            <h2>New Arrivals</h2>
            <p>
                Fresh finds<br>
                added regularly
            </p>
            <span class="category-arrow"><span class="icon icon-arrow-right"></span></span>
        </div>

        <div class="category-mobile">
            <span class="category-circle" style="background-image: url('/images/categories/new-arrivals-small.png');"></span>
            <span class="category-label">New Arrivals</span>
        </div>
    </a>
</section>


        <!-- =========================
             PRODUCTS
        ========================== -->

        <section class="products-section">

            <div class="section-heading">

                <h2>
                    Latest Finds
                    <span class="sparkle">✧</span>
                </h2>

                <a href="/shop" class="view-all">
                    View All <span class="icon icon-arrow-right"></span>
                </a>

            </div>


            <%- include("partials/product-grid", {
                products,
                minorPills: typeof minorPills !== "undefined" ? minorPills : [],
                activeCategories: typeof activeCategories !== "undefined" ? activeCategories : [],
                activeDepartment: typeof activeDepartment !== "undefined" ? activeDepartment : ""
            }) %>

        </section>

    </main>


    <%- include("partials/footer") %>

</div>

</body>
</html>