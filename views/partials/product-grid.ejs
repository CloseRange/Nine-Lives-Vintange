<%
    const _minorPills = typeof minorPills !== "undefined" ? minorPills : [];
    const _colorFilters = typeof colorFilters !== "undefined" ? colorFilters : [];
    const _brandFilters = typeof brandFilters !== "undefined" ? brandFilters : [];
    const _sizeFilters = typeof sizeFilters !== "undefined" ? sizeFilters : [];
    const _activeCategories = typeof activeCategories !== "undefined" ? activeCategories : [];
    const _activeColors = typeof activeColors !== "undefined" ? activeColors : [];
    const _activeBrands = typeof activeBrands !== "undefined" ? activeBrands : [];
    const _activeSizes = typeof activeSizes !== "undefined" ? activeSizes : [];
    const _activeDepartment = typeof activeDepartment !== "undefined" ? activeDepartment : "";
    const _cartSkus = typeof cartSkus !== "undefined" && Array.isArray(cartSkus) ? cartSkus : [];
%>

<div class="shop-layout">

    <!-- Filters (desktop sidebar) -->

    <aside class="filters-sidebar">

        <div class="filters-sidebar-header">
            <h3>Filters</h3>

            <% if (_activeCategories.length || _activeColors.length || _activeBrands.length || _activeSizes.length) { %>
                <a
                    href="/shop<%= _activeDepartment ? '?department=' + _activeDepartment : '' %>"
                    class="filters-clear"
                >
                    Clear all
                </a>
            <% } %>
        </div>

        <form action="/shop" method="GET" class="filters-form">

            <% if (_activeDepartment) { %>
                <input type="hidden" name="department" value="<%= _activeDepartment %>">
            <% } %>

            <% _minorPills.filter(pill => pill.slug !== "all").forEach(pill => { %>

                <label class="filter-checkbox">
                    <input
                        type="checkbox"
                        name="category"
                        value="<%= pill.slug %>"
                        onchange="this.form.submit()"
                        <%= _activeCategories.includes(pill.slug) ? "checked" : "" %>
                    >
                    <span><%= pill.label %></span>
                </label>

            <% }) %>

            <% if (_colorFilters.length) { %>
                <div class="filter-group">
                    <div class="filter-group-header">Color</div>

                    <% _colorFilters.forEach(color => { %>
                        <label class="filter-color-option">
                            <input
                                type="checkbox"
                                name="color"
                                value="<%= color.label %>"
                                onchange="this.form.submit()"
                                <%= _activeColors.includes(color.label) ? "checked" : "" %>
                            >

                            <span
                                class="filter-color-swatch"
                                style="background: <%= color.hex %>;"
                                aria-hidden="true"
                            ></span>

                            <span class="filter-color-label"><%= color.label %></span>
                            <span class="filter-color-count">(<%= color.count %>)</span>
                        </label>
                    <% }) %>
                </div>
            <% } %>

            <% if (_brandFilters.length) { %>
                <div class="filter-group">
                    <div class="filter-group-header">Brand</div>

                    <% _brandFilters.forEach(brand => { %>
                        <label class="filter-value-option">
                            <input
                                type="checkbox"
                                name="brand"
                                value="<%= brand.label %>"
                                onchange="this.form.submit()"
                                <%= _activeBrands.includes(brand.label) ? "checked" : "" %>
                            >
                            <span class="filter-value-label"><%= brand.label %></span>
                            <span class="filter-value-count">(<%= brand.count %>)</span>
                        </label>
                    <% }) %>
                </div>
            <% } %>

            <% if (_sizeFilters.length) { %>
                <div class="filter-group">
                    <div class="filter-group-header">Size</div>

                    <% _sizeFilters.forEach(size => { %>
                        <label class="filter-value-option">
                            <input
                                type="checkbox"
                                name="size"
                                value="<%= size.label %>"
                                onchange="this.form.submit()"
                                <%= _activeSizes.includes(size.label) ? "checked" : "" %>
                            >
                            <span class="filter-value-label"><%= size.label %></span>
                            <span class="filter-value-count">(<%= size.count %>)</span>
                        </label>
                    <% }) %>
                </div>
            <% } %>

        </form>

    </aside>

    <div class="products-column">

        <!-- Filters (mobile pills) -->

        <div class="product-toolbar">

            <div class="filters">

                <% _minorPills.forEach(pill => { %>

                    <%
                        const isAllPill = pill.slug === "all";
                        const isActivePill = isAllPill ? _activeCategories.length === 0 : _activeCategories.includes(pill.slug);
                        const pillHref = "/shop?" + (_activeDepartment ? "department=" + _activeDepartment + "&" : "") + (isAllPill ? "" : "category=" + pill.slug);
                    %>

                    <a
                        href="<%= pillHref %>"
                        class="filter <%= isActivePill ? 'active' : '' %>"
                    >
                        <%= pill.label %>
                    </a>

                <% }) %>

            </div>


            <form action="/shop" method="GET">

                <% if (_activeDepartment) { %>
                    <input type="hidden" name="department" value="<%= _activeDepartment %>">
                <% } %>

                <% _activeCategories.forEach(cat => { %>
                    <input type="hidden" name="category" value="<%= cat %>">
                <% }) %>

                <% _activeColors.forEach(color => { %>
                    <input type="hidden" name="color" value="<%= color %>">
                <% }) %>

                <% _activeBrands.forEach(brand => { %>
                    <input type="hidden" name="brand" value="<%= brand %>">
                <% }) %>

                <% _activeSizes.forEach(size => { %>
                    <input type="hidden" name="size" value="<%= size %>">
                <% }) %>

                <select name="sort" onchange="this.form.submit()">
                    <option value="newest">
                        Sort by: Newest
                    </option>

                    <option value="price-low">
                        Price: Low to High
                    </option>

                    <option value="price-high">
                        Price: High to Low
                    </option>
                </select>

            </form>

        </div>


        <!-- Product Grid -->

        <div class="product-grid">

    <% if (typeof products !== "undefined" && products.length) { %>

        <% products.forEach(product => { %>

            <article class="product-card">

                <a
                    href="/product/<%= product.sku %>"
                    class="product-image"
                >

                    <% if (product.images?.length > 0) { %>

                        <img
                            src="<%= product.images[0].image_url %>"
                            alt="<%= product.title %>"
                            loading="lazy"
                            class="product-image-primary"
                        >

                    <% } else { %>

                        <img
                            src="/images/product-placeholder.png"
                            alt="No image available"
                            loading="lazy"
                            class="product-image-primary"
                        >

                    <% } %>

                    <% if (product.images?.length > 1) { %>

                        <img
                            src="<%= product.images[1].image_url %>"
                            alt="<%= product.title %>"
                            loading="lazy"
                            class="product-image-secondary"
                        >

                    <% } %>

                    <% if (product.badge) { %>

                        <span class="
                            product-badge
                            badge-<%= product.badge.toLowerCase() %>
                        ">
                            <%= product.badge %>
                        </span>

                    <% } %>


                    <button
                        class="favorite-button"
                        type="button"
                        aria-label="Add <%= product.title %> to favorites"
                    >
                        <span class="icon icon-heart"></span>
                    </button>

                </a>


                <div class="product-info">

                    <a
                        href="/product/<%= product.sku %>"
                        class="product-name"
                    >
                        <%= product.title %>
                    </a>


                    <p class="product-meta">

                        <%= product.category_id || "Unisex" %>

                        <% if (product.size) { %>
                            · Size <%= product.size %>
                        <% } %>

                    </p>


                    <div class="product-bottom">

                        <strong class="product-price">
                            $<%= Number(product.price).toFixed(2) %>
                        </strong>


                        <% if (_cartSkus.includes(String(product.sku))) { %>
                            <a class="add-cart-button is-in-cart" href="/cart" aria-label="View cart">
                                <span class="add-cart-circle">
                                    <span class="icon icon-check"></span>
                                </span>
                                <span class="add-cart-label">In Cart</span>
                            </a>
                        <% } else { %>
                            <form action="/cart/add" method="POST" data-cart-add-form>
                                <input type="hidden" name="sku" value="<%= product.sku %>">
                                <button class="add-cart-button" type="submit" aria-label="Add to cart">
                                    <span class="add-cart-circle">
                                        <span class="icon icon-cart"></span>
                                        <span class="icon icon-check"></span>
                                    </span>
                                    <span class="add-cart-label">In Cart</span>
                                </button>
                            </form>
                        <% } %>

                    </div>

                </div>

            </article>

        <% }) %>


    <% } else { %>

        <div class="empty-products">

            <span class="icon icon-paw"></span>

            <h3>No items yet</h3>

            <p>
                New finds will be added soon!
            </p>

        </div>

    <% } %>

        </div>

    </div>

</div>

<script>
    document.addEventListener('submit', async (event) => {
        const form = event.target.closest('[data-cart-add-form]');
        if (!form) return;

        event.preventDefault();
        const button = form.querySelector('button[type="submit"]');
        if (!button || button.disabled) return;

        button.disabled = true;

        try {
            const response = await fetch(form.action, {
                method: 'POST',
                headers: {
                    Accept: 'application/json',
                    'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8'
                },
                body: new URLSearchParams(new FormData(form))
            });
            const result = await response.json();
            if (!response.ok || !result.ok) throw new Error(result.error || 'Could not add item to cart.');

            button.classList.add('is-in-cart', 'just-added');
            button.dataset.inCart = 'true';
            button.setAttribute('aria-label', 'View cart');
            button.innerHTML = '<span class="add-cart-circle"><span class="icon icon-cart"></span><span class="icon icon-check"></span></span><span class="add-cart-label">In Cart</span>';
            button.disabled = false;

            const cartLink = document.querySelector('[data-cart-button]');
            if (cartLink) {
                let count = cartLink.querySelector('[data-cart-count]');
                if (!count) {
                    count = document.createElement('span');
                    count.className = 'cart-count';
                    count.setAttribute('data-cart-count', '');
                    cartLink.append(count);
                }
                count.textContent = result.cartCount;
            }

            window.setTimeout(() => button.classList.remove('just-added'), 320);
        } catch (error) {
            console.error('[CART] Failed to add item:', error);
            button.disabled = false;
        }
    });

    document.addEventListener('click', (event) => {
        const button = event.target.closest('button[data-in-cart="true"]');
        if (!button) return;

        event.preventDefault();
        window.location.assign('/cart');
    });
</script>
