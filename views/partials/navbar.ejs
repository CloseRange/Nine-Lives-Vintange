<header class="site-header">
    <a href="/shop" class="brand" aria-label="Nine Lives Vintage shop">
        <img
            src="/images/nine-lives-name.png"
            alt="Nine Lives Vintage"
            class="brand-logo"
        >
    </a>

    <% const navActiveDepartment = typeof activeDepartment !== 'undefined' ? activeDepartment : ''; %>
    <% const isShopActive = currentPage === 'shop' && !navActiveDepartment; %>
    <% const isWomenActive = currentPage === 'shop' && navActiveDepartment === 'women'; %>
    <% const isMenActive = currentPage === 'shop' && navActiveDepartment === 'men'; %>
    <% const isAccessoriesActive = currentPage === 'shop' && navActiveDepartment === 'accessories'; %>
    <% const isNewArrivalsActive = currentPage === 'shop' && navActiveDepartment === 'new-arrivals'; %>

    <nav class="desktop-nav" aria-label="Main navigation">
        <a href="/shop" class="<%= isShopActive ? 'active' : '' %>">
            Shop
        </a>

        <a href="/shop?department=women" class="<%= isWomenActive ? 'active' : '' %>">Women</a>
        <a href="/shop?department=men" class="<%= isMenActive ? 'active' : '' %>">Men</a>
        <a href="/shop?department=accessories" class="<%= isAccessoriesActive ? 'active' : '' %>">Accessories</a>
        <a href="/shop?department=new-arrivals" class="<%= isNewArrivalsActive ? 'active' : '' %>">New Arrivals</a>
        <a href="/about">About</a>
    </nav>

    <form class="header-search" action="/shop" method="GET">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-4-4"></path>
        </svg>

        <input
            type="search"
            name="q"
            placeholder="Search items..."
            aria-label="Search items"
        >
    </form>

    <div class="header-actions">
        <% if (currentUser) { %>
            <a href="/account" class="account-pill" aria-label="Account">
                <span class="account-pill-name"><%= currentUser.displayName || currentUser.email || 'Account' %></span>
                <span class="account-pill-icon-wrap" aria-hidden="true">
                    <span class="icon icon-user"></span>
                </span>
            </a>
        <% } else { %>
            <a href="/account" class="icon-button" aria-label="Account">
                <span class="icon icon-user"></span>
            </a>
        <% } %>

        <a href="/cart" class="icon-button cart-button" aria-label="Cart" data-cart-button>
            <span class="icon icon-cart"></span>

            <% if (typeof cartCount !== "undefined" && cartCount > 0) { %>
                <span class="cart-count" data-cart-count><%= cartCount %></span>
            <% } %>
        </a>
    </div>
</header>